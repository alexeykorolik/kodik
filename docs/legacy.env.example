# Leave empty to use local browser progress (the default for the MVP).
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# Browser default: /api. Android public configuration is in vite.android.config.ts.
# VITE_API_BASE_URL=/api

# AI is unconditionally paused in this release; these legacy flags cannot enable it.
# VITE_AI_TUTOR_ENABLED=false
# VITE_AI_EXPLANATIONS_ENABLED=false
# VITE_AI_EXAMPLES_ENABLED=false
# AI_TUTOR_ENABLED=false
# AI_EXPLANATIONS_ENABLED=false
# AI_EXAMPLES_ENABLED=false
# AI_PRACTICE_GENERATION_ENABLED=false
# GROQ_API_KEY=add-only-in-server-environment
# GROQ_TUTOR_MODEL=openai/gpt-oss-20b
# Optional alternate provider when Groq is not configured:
# OPENAI_TUTOR_MODEL=your-approved-model
# OPENAI_API_KEY=add-only-in-server-environment
# Anonymous central events (server keys are never VITE variables)
# VITE_ANALYTICS_ENABLED=false
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only
# AI_LEARNER_DAILY_LIMIT=80
# AI_IP_DAILY_LIMIT=200
# AI_DAILY_REQUEST_LIMIT=1000
