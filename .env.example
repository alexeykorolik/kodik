# Kodik Schools: server environment for npm start.
# npm start reads process environment; it does not automatically load this file.
# Set these values in the terminal or service configuration.
PORT=4173
HOST=127.0.0.1
# Local default database: data/kodik.sqlite, relative to the project.
# KODIK_DB=D:/projects/kodik/data/kodik.sqlite

# Production requires BOTH an exact HTTPS origin and an absolute persistent DB path.
# NODE_ENV=production
# KODIK_ORIGIN=https://school.example
# KODIK_DB=D:/persistent/kodik/kodik.sqlite
# HOST=0.0.0.0
# Configure HTTPS at the selected reverse proxy; choose hosting separately.

# AI is unconditionally disabled. No provider keys are required or used.
# Legacy standalone-course settings are documented in docs/legacy.env.example.
